<UserControl x:Class="DeskManagementStand_App.View.UserControls.ChargingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeskManagementStand_App.View.UserControls"
             xmlns:Model="clr-namespace:DeskManagementStand_App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="25*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="ChargingGrid" Grid.Column="0" SizeChanged="ChargingGrid_SizeChanged">
        </Grid>
        <Border Grid.Column="1" Background="Gray" Width="2" Margin="2,0,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Stretch" 
                CornerRadius="4" Opacity="0.2"/>
        <Grid x:Name="ChargingTextGrid" Grid.Column="1">
            <StackPanel Orientation="Horizontal" Margin="10">
                <StackPanel Orientation="Vertical">
                    <!--
                    <TextBlock x:Name="Test1" 
                               Text="1.23" 
                               FontSize="20" 
                               Foreground="Black" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="Test2" 
            Text="3.3" 
            FontSize="20" 
            Foreground="Black" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"/>
                    <TextBlock x:Name="Test3" 
            Text="4.059" 
            FontSize="20" 
            Foreground="Black" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"/>
                    -->
                    <TextBlock x:Name="TextBlockVoltage"
                               Text="{Binding PhoneData.Voltage}"
                                FontSize="20" 
                                Foreground="Black" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"/>
                               <!--Text="{Binding PhoneData.Voltage, StringFormat={}{0} [V]}"-->       
                                
                    <TextBlock x:Name="TextBlockCurrent" 
                               Text="{Binding PhoneData.Current}" 
                               FontSize="20" 
                               Foreground="Black" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TextBlockPower" 
                               Text="{Binding PhoneData.Power}" 
                               FontSize="20" 
                               Foreground="Black" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="TextBlockVoltageStatic" 
                               Text="mV" 
                               FontSize="20" 
                               Foreground="Black" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TextBlockCurrentStatic" 
                               Text="mA" 
                               FontSize="20" 
                               Foreground="Black" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TextBlockPowerStatic" 
                               Text="W" 
                               FontSize="20" 
                               Foreground="Black" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            
        </Grid>
    </Grid>
        
</UserControl>
